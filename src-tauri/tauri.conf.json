{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "genealogy",
  "version": "0.1.1",
  "identifier": "com.mugbya.genealogy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "祖谱软件",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": true,
        "devtools": true,
        "userAgent": "GenealogyDesktop/1.0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://zupu-1256812051.cos.ap-chengdu.myqcloud.com/updates/latest.json"
      ],
